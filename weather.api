#Importing required modules
import pandas as pd
import requests
import json as js
#Converting the url into JSON
link ="https://api.open-meteo.com/v1/forecast?latitude=52.52&longitude=13.41&hourly=temperature_2m&utm_source=chatgpt.com" 
rl = requests.get(link)

forecast = rl.json()
#reading the JSON file
with open("forecast.json", "w") as file:
    js.dump(forecast, file, indent=4)

print("Weather data saved successfully!") 
#Viewing using pandas
df =  pd.DataFrame({
    "time": forecast["hourly"]["time"],
    "temperature": forecast["hourly"]["temperature_2m"]
})

df.head() 
df.info()
df.describe() 
# py tests
def test_api_has_hourly_data():
    assert "hourly" in forecast 
def test_time_and_temperature_same_length():
    assert len(forecast["hourly"]["time"]) == len(
        forecast["hourly"]["temperature_2m"])
    
def test_time_and_temperature_same_length():
    assert len(forecast["hourly"]["time"]) == len(
        forecast["hourly"]["temperature_2m"])
     
